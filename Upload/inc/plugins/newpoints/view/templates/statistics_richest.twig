<div class="block-columns__item block block--container">
    <h2 class="title title--minor">
        {{ trans(
            'newpoints_richest_users',
            instance.get_display_name_upper(),
            instance.get_display_name_lower()) }}
    </h2>
    {% if richest_users|length > 0 %}
        {% for user_id,stat in richest_users %}
            <div class="row row--simple-columns buddy-request">
                <div>
                    <a href="{{ get_profile_link(user_id) }}">{{ {
                            'username': stat.user.username,
                            'usergroup': stat.user.usergroup,
                            'displaygroup': stat.user.displaygroup}|format_name }}</a>
                </div>
                <div>
                    {{ stat.amount }}
                </div>
            </div>
        {% endfor %}
    {% else %}
        <div class="no-results">
            {{ lang.newpoints_noresults }}
        </div>
    {% endif %}
</div>